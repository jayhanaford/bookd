{
  "name": "bookd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "postinstall": "npm run tokens",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc -b --noEmit",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6007",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build",
    "pretest:stories": "npm run tokens",
    "test:stories": "vitest --project=storybook --run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.8",
    "style-dictionary": "^5.8.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
