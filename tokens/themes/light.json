{
  "semantic": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "{color.gray.50}",
        "$description": "Main app background."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Secondary container, search field."
      },
      "surface-hover": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Hover on surface and secondary/tertiary buttons."
      },
      "card": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Venue and ticket cards. White in both themes."
      },
      "card-muted": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Supporting block inside a card."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Disabled control fill."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.charcoal.950}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.gray.700}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$description": "Disabled text. Exempt from contrast minimums."
      },
      "accent": {
        "$type": "color",
        "$value": "{color.pink.700}",
        "$description": "Links, 'View all', eyebrow labels. QA: pink.500 fails on surfaces."
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.charcoal.950}",
        "$description": "Label on the gradient/pink CTA. QA: white fails (3.5:1)."
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$description": "Decorative dividers only."
      },
      "control": {
        "$type": "color",
        "$value": "{color.gray.500}",
        "$description": "Input and control boundaries, meets 3:1."
      },
      "contrast": {
        "$type": "color",
        "$value": "{color.charcoal.950}",
        "$description": "Secondary button outline."
      },
      "card": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$description": "Edge of a white card. Cards on the dark shell are light islands, so this is the same in both themes."
      }
    },
    "action": {
      "primary": {
        "fallback": {
          "$type": "color",
          "$value": "{color.pink.500}",
          "$description": "Solid CTA when a gradient can't be used."
        },
        "fallback-hover": {
          "$type": "color",
          "$value": "{color.pink.400}"
        },
        "fallback-pressed": {
          "$type": "color",
          "$value": "{color.pink.600}"
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.pink.700}",
        "$description": "Focus-visible outline, 3:1 against canvas, surface and card in its theme."
      }
    },
    "status": {
      "confirmed": {
        "fg": {
          "$type": "color",
          "$value": "{color.green.600}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.green.200}"
        },
        "$description": "Booked and accepted."
      },
      "pending": {
        "fg": {
          "$type": "color",
          "$value": "{color.amber.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.amber.100}"
        },
        "$description": "Awaiting action."
      },
      "declined": {
        "fg": {
          "$type": "color",
          "$value": "{color.red.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.red.100}"
        },
        "$description": "Declined or canceled."
      },
      "open": {
        "fg": {
          "$type": "color",
          "$value": "{color.pink.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.lilac.100}"
        },
        "$description": "Open gig or accepting inquiries."
      },
      "unknown": {
        "fg": {
          "$type": "color",
          "$value": "{color.gray.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.gray.100}"
        },
        "$description": "Unverified or stale venue info."
      }
    },
    "gradient": {
      "action": {
        "primary": {
          "$type": "gradient",
          "$value": "linear-gradient(110deg, {color.pink.500} 0%, {color.purple.500} 100%)",
          "$description": "Primary CTA. Use with text.on-action."
        },
        "primary-hover": {
          "$type": "gradient",
          "$value": "linear-gradient(110deg, {color.pink.400} 0%, {color.purple.400} 100%)"
        },
        "primary-pressed": {
          "$type": "gradient",
          "$value": "linear-gradient(110deg, {color.pink.600} 0%, {color.purple.600} 100%)"
        }
      },
      "brand": {
        "soft": {
          "$type": "gradient",
          "$value": "linear-gradient(125deg, {color.lilac.100} 0%, {color.white} 100%)",
          "$description": "Soft highlight panels."
        }
      },
      "media": {
        "scrim": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, rgba(11, 11, 15, 0) 25%, rgba(11, 11, 15, 0.9) 100%)",
          "$description": "Text over photography."
        }
      }
    }
  }
}
